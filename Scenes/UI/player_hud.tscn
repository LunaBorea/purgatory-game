[sub_resource type="Shader" id="Shader_sanity_fill"]
code = "shader_type canvas_item;\nuniform float depletion : hint_range(0.0, 1.0) = 0.0;\nuniform vec4 red_tint : source_color = vec4(0.88, 0.10, 0.035, 1.0);\nvoid fragment() {\n\tvec4 color = texture(TEXTURE, UV) * COLOR;\n\tfloat edge = 1.0 - depletion;\n\tfloat fill_mask = smoothstep(edge - 0.004, edge + 0.004, UV.x);\n\tfloat fill_width = max(depletion, 0.0001);\n\tfloat distance_from_start = clamp((1.0 - UV.x) / fill_width, 0.0, 1.0);\n\tfloat red_amount = depletion * (1.0 - distance_from_start);\n\tcolor.rgb = mix(color.rgb, red_tint.rgb, red_amount);\n\tcolor.a *= fill_mask;\n\tCOLOR = color;\n}"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_sanity_fill"]
shader = SubResource("Shader_sanity_fill")

[sub_resource type="AtlasTexture" id="AtlasTexture_health_loss"]
atlas = ExtResource("1_full")
region = Rect2(428, 181, 410, 19)

[sub_resource type="Shader" id="Shader_health_loss"]
code = "shader_type canvas_item;\nuniform float health_fraction = 1.0;\nvoid fragment() {\n\tvec4 color = texture(TEXTURE, UV) * COLOR;\n\tfloat loss = smoothstep(health_fraction, min(health_fraction + 0.015, 1.01), UV.x);\n\tcolor.a *= loss;\n\tCOLOR = color;\n}"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_health_loss"]
shader = SubResource("Shader_health_loss")

[sub_resource type="Shader" id="Shader_orb_vignette"]
code = "shader_type canvas_item;\nuniform float strength : hint_range(0.0, 0.3) = 0.0;\nuniform float edge_width : hint_range(0.01, 0.5) = 0.12;\nuniform float softness : hint_range(0.01, 0.5) = 0.16;\nvoid fragment() {\n\tfloat edge_distance = min(min(UV.x, 1.0 - UV.x), min(UV.y, 1.0 - UV.y));\n\tfloat vignette = 1.0 - smoothstep(edge_width, edge_width + softness, edge_distance);\n\tCOLOR = vec4(0.0, 0.0, 0.0, strength * vignette);\n}"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_orb_vignette"]
shader = SubResource("Shader_orb_vignette")
[sub_resource type="Shader" id="Shader_damage_outline"]
code = "shader_type canvas_item;\nuniform float strength : hint_range(0.0, 1.0) = 0.0;\nvoid fragment() {\n\tfloat edge_distance = min(min(UV.x, 1.0 - UV.x), min(UV.y, 1.0 - UV.y));\n\tfloat border = 1.0 - smoothstep(0.012, 0.035, edge_distance);\n\tCOLOR = vec4(0.95, 0.025, 0.04, border * strength * 0.8);\n}"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_damage_outline"]
shader = SubResource("Shader_damage_outline")

